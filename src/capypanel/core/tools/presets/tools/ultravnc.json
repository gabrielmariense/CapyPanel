{
  "schema": 1,
  "id": "ultravnc",
  "name": "UltraVNC Viewer",
  "kind": "vnc",
  "port": 5900,
  "credentials": "arguments",
  "options": {
    "securevnc": "SecureVNC plugin"
  },
  "account_types": [113, 114, 115, 118],
  "max_password": {"password": 8},
  "website": "https://uvnc.com/downloads/ultravnc.html",
  "settings_file": {"extension": ".vnc", "clear": ["host"]},
  "arguments": [
    ["-config", "{settings_file}"],
    ["{address}::{port}"],
    {"option": "securevnc", "arguments": ["-dsmplugin", "SecureVNCPlugin64.dsm"]},
    ["-user", "{user}"],
    ["-password", "{password}"]
  ],
  "detect": {
    "installed_as": ["UltraVNC"],
    "exe": "vncviewer.exe",
    "paths": [
      "%ProgramFiles%\\uvnc bvba\\UltraVNC\\vncviewer.exe",
      "%ProgramFiles(x86)%\\uvnc bvba\\UltraVNC\\vncviewer.exe",
      "%ProgramFiles%\\UltraVNC\\vncviewer.exe",
      "%ProgramFiles(x86)%\\UltraVNC\\vncviewer.exe"
    ]
  }
}
