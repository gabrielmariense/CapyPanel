msgstr "O {tool} não tem a opção “{option}”."

#, python-brace-format
msgid "{tool} not found"
msgstr "{tool} não encontrado"

#, python-brace-format
msgid "{tool} wasn't found on this PC. Install it, or show CapyPanel where it is. The path is saved for everyone on this PC; you can also change it later in Settings > Connections > Remote tools."
msgstr "O {tool} não foi encontrado neste PC. Instale-o ou mostre ao CapyPanel onde ele está. O caminho fica salvo para todos neste PC; você também pode alterá-lo depois em Configurações > Conexões > Ferramentas remotas."

msgid "“account_types” must be a list of numbers from 1 to 255."
msgstr "“account_types” deve ser uma lista de números de 1 a 255."

msgid "“detect” has a value of the wrong type."
msgstr "“detect” tem um valor do tipo errado."

msgid "“detect” must be an object."
msgstr "“detect” deve ser um objeto."

msgid "“max_password” must map logins to a length."
msgstr "“max_password” deve associar logins a um tamanho."

msgid "“options” must map option ids to the names shown."
msgstr "“options” deve associar ids de opções aos nomes exibidos."

msgid "“settings_file” needs an “extension” such as “.vnc” and a list to “clear”."
msgstr "“settings_file” precisa de uma “extension”, como “.vnc”, e de uma lista em “clear”."

#, python-brace-format
msgid "“{key}” must be a list."
msgstr "“{key}” deve ser uma lista."

#, python-brace-format
msgid "“{name}” has no address, and its name can't be used as one: a computer name has no spaces or symbols other than - and _."
msgstr "“{name}” não tem endereço, e o nome não pode ser usado como um: um nome de computador não tem espaços nem símbolos além de - e _."

